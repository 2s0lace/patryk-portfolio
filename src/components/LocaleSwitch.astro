<div class="locale-switch" role="group" data-i18n-attr="aria-label:common.localeLabel">
  <button
    class="locale-button"
    type="button"
    data-locale-target="en"
    aria-pressed="false"
  >EN</button>
  <button
    class="locale-button is-active"
    type="button"
    data-locale-target="pl"
    aria-pressed="true"
  >PL</button>
</div>

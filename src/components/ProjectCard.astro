---
import type { PortfolioProject } from "../data/projects";

type Props = PortfolioProject;

const {
  number,
  title,
  type,
  typeKey,
  href,
  image,
  imageAlt = "",
  visualText,
  stat,
  statKey,
  wip = false,
  wipKey,
  tone = "ink",
  size = "standard",
  sources,
} = Astro.props;
---

<article class:list={["work-card", `work-card-${size}`]}>
  <a
    class="card-visual-link"
    href={href}
    target="_blank"
    rel="noreferrer"
    aria-label={`Open ${title}`}
  >
    <div class:list={["card-visual", !image && `visual-${tone}`, visualText && stat && "has-dual-copy"]}>
      {image ? (
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      ) : (
        <span class="visual-word">{visualText}</span>
      )}
      <span class="visual-label">{number}</span>
      {stat && (
        <span class="card-stat" data-i18n={statKey}>{stat}</span>
      )}
      <span class="card-open" aria-hidden="true">↗</span>
    </div>
  </a>

  <div class="card-meta">
    <div class="card-title-group">
      <h3><a href={href} target="_blank" rel="noreferrer">{title}</a></h3>
      <p data-i18n={typeKey}>{type}</p>
      {wip && <span class="card-wip" data-i18n={wipKey}>work in progress</span>}
    </div>
    <div class="card-sources" aria-label="Project sources">
      {sources.map((source) => (
        <a class="source-pill" href={source.href} target="_blank" rel="noreferrer">
          <span>{source.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</article>

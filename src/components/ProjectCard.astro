---
interface Props {
  number: string;
  title: string;
  type: string;
  theme: "sand" | "olive";
  large?: boolean;
}

const { number, title, type, theme, large = false } = Astro.props;
---

<article class:list={["work-card", large && "work-card-large"]}>
  <div class:list={["card-visual", `visual-${theme}`]}>
    <span class="visual-label">{number}</span>

    {theme === "sand" ? (
      <>
        <span class="visual-shape shape-circle"></span>
        <span class="visual-shape shape-stair"></span>
      </>
    ) : (
      <>
        <span class="visual-word" data-i18n="projectTwoVisual">still
moving</span>
        <span class="visual-shape shape-square"></span>
      </>
    )}
  </div>
  <div class="card-meta">
    <div>
      <h3 data-i18n={theme === "sand" ? "projectOneTitle" : "projectTwoTitle"}>{title}</h3>
      <p data-i18n={theme === "sand" ? "projectOneType" : "projectTwoType"}>{type}</p>
    </div>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </div>
</article>

<div class="theme-switch" role="group" data-i18n-attr="aria-label:common.themeLabel">
  <button
    class="theme-option"
    type="button"
    data-theme-target="light"
    data-i18n="common.lightTheme"
    aria-pressed="true"
  >Jasny</button>
  <button
    class="theme-option"
    type="button"
    data-theme-target="dark"
    data-i18n="common.darkTheme"
    aria-pressed="false"
  >Ciemny</button>
</div>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocaleSwitch from "../components/LocaleSwitch.astro";
import ModeSwitch from "../components/ModeSwitch.astro";
import ProjectMini from "../components/ProjectMini.astro";
import "../styles/structure-preview.css";
import SectionPicker from "../components/SectionPicker.astro";
import SocialLinks from "../components/SocialLinks.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import AboutBio from "../components/AboutBio.astro";
import { patrykProjects, solaceProjects, githubProjects } from "../data/projects";

interface Props {
  initialMode?: "patryk" | "2s0lace";
}

const { initialMode = "patryk" } = Astro.props;
---

<BaseLayout mode={initialMode}>
  <div class="site-shell">
    <header class="topbar">
      <div class="topbar-main">
        <div class="control-cluster">
          <ModeSwitch />
          <div class="utility-pill">
            <ThemeToggle />
            <LocaleSwitch />
            <a class="contact-link" href="#section-7" data-section-link="section7">
              <span data-i18n="common.contact">Kontakt</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <SocialLinks />
      </div>

    </header>

    <main id="top">
      <div class="landing-stage">
      <section class="hero" id="section-1" data-section="section1" aria-labelledby="hero-title">
        <div class="hero-identity">
        <p class="availability-status" data-i18n-attr="aria-label:common.statusLabel">
          <span class="availability-pulse" aria-hidden="true"></span>
          <span data-i18n="common.openToWork">otwarty na projekty</span>
        </p>
        <h1 id="hero-title">
          <span data-i18n="heroHeadline" data-i18n-ipa>[<span class="ipa-glyph">ˈ</span>patr<span class="ipa-glyph">ɨ</span>k]</span>
        </h1>
        </div>
      </section>

      <SectionPicker />
      <p class="mode-toast" id="mode-toast" role="status" aria-live="polite" hidden>
        <span class="mode-toast-dot" aria-hidden="true"></span>
        <span data-i18n="common.checkPatryk">Sprawdź tryb Patryk</span>
      </p>
      </div>

      <section
        class="selected-work"
        id="section-6"
        data-section="section6"
        aria-labelledby="work-title"
      >
        <div class="section-heading">
          <p class="section-kicker" data-i18n="portfolioKicker">01 / portfolio</p>
          <h2 id="work-title" data-i18n="workTitle">Wybrane projekty.</h2>
        </div>

        <div class="work-collection" data-mode-only="patryk" hidden={initialMode !== "patryk"}>
          <div class="project-mini-grid">{[...patrykProjects, ...githubProjects].map((project) => <ProjectMini {...project} />)}</div>
          <div class="portfolio-link-pills">
          <a class="portfolio-more" href="https://www.behance.net/2s0lace" target="_blank" rel="noreferrer">
            <span data-i18n="portfolioMorePatryk">Więcej case studies na Behance</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a class="portfolio-more" href="https://github.com/2s0lace" target="_blank" rel="noreferrer">
            <span data-i18n="common.portfolioMoreGithub">Więcej projektów na GitHubie</span>
            <span aria-hidden="true">↗</span>
          </a>
          </div>
        </div>

        <div class="work-collection" data-mode-only="2s0lace" hidden={initialMode !== "2s0lace"}>
          <div class="project-mini-grid">{solaceProjects.map((project) => <ProjectMini {...project} />)}</div>
          <a class="portfolio-more" href="https://www.instagram.com/2s0lace/" target="_blank" rel="noreferrer">
            <span data-i18n="portfolioMoreSolace">Więcej prac na Instagramie</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section
        class="statement"
        id="section-3"
        data-section="section3"
        aria-labelledby="about-title"
      >
        <div class="section-heading">
          <p class="section-kicker" data-i18n="aboutKicker">03 / o mnie</p>
          <h2 id="about-title" data-i18n="aboutTitle">O mnie.</h2>
          <p class="about-ai-joke" data-mode-only="2s0lace" hidden data-i18n="aboutAiJoke">
            (jk, please see portfolio)
          </p>
        </div>

        <AboutBio />
        <div class="ai-chat" id="ai-chat" data-mode-only="2s0lace" hidden>
          <div class="ai-chat-form">
            <label class="visually-hidden" for="ai-chat-input" data-i18n="aboutAiPromptLabel">
              Ask about 2s0lace on Instagram
            </label>
            <input
              class="ai-chat-input"
              id="ai-chat-input"
              type="text"
              value="hoo is 2s0lace instegrem"
              readonly
              aria-readonly="true"
              data-i18n-attr="value:aboutAiPrompt"
            />
            <button
              class="ai-chat-send"
              type="button"
              id="ai-chat-send"
              aria-controls="ai-chat-output"
              aria-expanded="false"
              data-i18n-attr="aria-label:aboutAiSendLabel"
              aria-label="Send message"
            >
              <span data-i18n="common.send">Wyślij</span>
            </button>
          </div>

          <div class="ai-chat-output" id="ai-chat-output" aria-live="polite" hidden>
            <p class="ai-chat-response" id="ai-chat-response" data-i18n="aboutAiResponse" hidden>
              2s0lace is an independent graphic design and multimedia art project. It combines poster, motion and the atmosphere of electronic music into short, personal moments.
            </p>
            <p class="ai-chat-thinking" id="ai-chat-thinking" role="status">
              <span class="ai-chat-diamond" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
              </span>
              <span class="ai-chat-shimmer" id="ai-chat-status" data-i18n="aboutAiThinking">Thinking</span>
            </p>
          </div>
        </div>


      </section>

      <section
        class="info-section"
        id="section-2"
        data-section="section2"
        aria-labelledby="cv-title"
      >
        <div class="section-heading">
          <p class="section-kicker" data-i18n="cvKicker">02 / cv</p>
          <h2 id="cv-title" data-i18n="cvTitle">CV.</h2>
        </div>

        <div class="cv-entries">
          <article class="cv-entry">
            <div class="cv-entry-meta">
              <p class="cv-entry-org" data-i18n="cvJmoOrg">JMO (autoryzowany dystrybutor OPPO Polska)</p>
              <p class="cv-entry-period" data-i18n="cvJmoPeriod">06.2026 — teraz</p>
            </div>
            <div class="cv-entry-content">
              <h3 class="cv-entry-role" data-i18n="cvJmoRole">Graphic & Motion Designer</h3>
              <ul class="cv-bullets">
                <li data-i18n="cvJmoBulletOne">Projektowanie key visuali, materiałów POSM i banerów e-commerce (Allegro, sklepy partnerskie) dla premier produktowych OPPO na rynek polski</li>
                <li data-i18n="cvJmoBulletTwo">Adaptacja i lokalizacja globalnych materiałów kampanijnych — KV, DTP, assety produktowe</li>
                <li data-i18n="cvJmoVideoLocalization">Lokalizacja materiałów wideo OPPO na rynek polski — tłumaczenie, adaptacja tekstów ekranowych i napisy</li>
                <li data-i18n="cvJmoBulletThree">Montaż i postprodukcja materiałów na social media — dwa filmy kampanii Reno16 5G z wynikiem 8,4M i 11,4M wyświetleń</li>
                <li data-i18n="cvJmoBulletFour">Animacja assetów wektorowych i grafika ruchoma w After Effects</li>
              </ul>
            </div>
          </article>

          <article class="cv-entry">
            <div class="cv-entry-meta">
              <p class="cv-entry-org" data-i18n="cvFreelanceOrg">Freelance</p>
              <p class="cv-entry-period" data-i18n="cvFreelancePeriod">2020 — teraz</p>
            </div>
            <div class="cv-entry-content">
              <h3 class="cv-entry-role" data-i18n="cvFreelanceRole">Graphic / Visual Designer</h3>
              <ul class="cv-bullets">
                <li data-i18n="cvFreelanceBulletOne">Identyfikacje wizualne, branding, okładki muzyczne i materiały e-sportowe: w tym prace z wynikiem 120K+ wyświetleń na YouTube i 10,4K+ na X</li>
                <li data-i18n="cvFreelanceBulletTwo">Audyt komunikacji i strategia wizualna dla placówki edukacyjnej: reklamy, koncepcja logotypu</li>
                <li data-i18n="cvFreelanceBulletThree">digiQUIZ — koncepcja aplikacji edukacyjnej o cyberbezpieczeństwie dla dzieci: UX/UI, art direction oparty na maskotce</li>
                <li data-i18n="cvFreelanceBulletFour">nAIczyciel.pl — produkt EdTech: koncepcja, UX/UI, integracja AI (Next.js, Supabase, OpenAI API)</li>
              </ul>
            </div>
          </article>

          <article class="cv-entry">
            <div class="cv-entry-meta">
              <p class="cv-entry-org" data-i18n="cvTeachingOrg">Nauczanie języka angielskiego</p>
              <p class="cv-entry-period" data-i18n="cvTeachingPeriod">2024 — teraz</p>
            </div>
            <div class="cv-entry-content">
              <h3 class="cv-entry-role" data-i18n="cvTeachingRole">Lektor / korepetytor</h3>
              <ul class="cv-bullets">
                <li data-i18n="cvTeachingBulletOne">Lektor w szkole językowej, obecnie korepetycje indywidualne i grupowe</li>
              </ul>
            </div>
          </article>
        </div>
      </section>

      <section
        class="info-section stack-section"
        id="section-stack"
        data-section="stack"
        aria-labelledby="stack-title"
      >
        <div class="section-heading">
          <p class="section-kicker" data-i18n="stackKicker">04 / stack</p>
          <h2 id="stack-title" data-i18n="stackTitle">Stack.</h2>
        </div>

        <div class="stack-grid">
          <div class="stack-group">
            <p class="stack-label" data-i18n="stackMotionLabel">MOTION / VIDEO</p>
            <div class="stack-values">
              <span data-i18n="stackMotionOne">After Effects</span>
              <span data-i18n="stackMotionTwo">short-form editing</span>
              <span data-i18n="stackMotionThree">composition</span>
              <span data-i18n="stackMotionFour">asset animation</span>
            </div>
          </div>
          <div class="stack-group">
            <p class="stack-label" data-i18n="stackGraphicLabel">GRAPHIC</p>
            <div class="stack-values">
              <span data-i18n="stackGraphicOne">Illustrator</span>
              <span data-i18n="stackGraphicTwo">Photoshop</span>
              <span data-i18n="stackGraphicThree">art direction</span>
              <span data-i18n="stackGraphicFour">key visuals</span>
              <span data-i18n="stackGraphicFive">brand identity</span>
              <span data-i18n="stackGraphicSix">typography</span>
            </div>
          </div>
          <div class="stack-group">
            <p class="stack-label" data-i18n="stackUxLabel">UX/UI · NO-CODE</p>
            <div class="stack-values">
              <span data-i18n="stackUxOne">Figma</span>
              <span data-i18n="stackUxTwo">wireframing</span>
              <span data-i18n="stackUxThree">user flows</span>
              <span data-i18n="stackUxFour">prototyping</span>
              <span data-i18n="stackUxFive">design systems</span>
            </div>
          </div>
          <div class="stack-group">
            <p class="stack-label" data-i18n="stackAiLabel">AI / TECHNICAL</p>
            <div class="stack-values">
              <span data-i18n="stackAiOne">Codex</span>
              <span data-i18n="stackAiTwo">Claude Code</span>
              <span data-i18n="stackAiThree">DeepSeek API</span>
              <span data-i18n="stackAiFour">OpenAI API</span>
              <span data-i18n="stackAiFive">Antigravity</span>
              <span data-i18n="stackAiSix">Lovable</span>
              <span data-i18n="stackAiSeven">Next.js</span>
              <span data-i18n="stackAiEight">Supabase</span>
              <span data-i18n="stackAiNine">Vercel</span>
              <span data-i18n="stackAiTen">prompt design</span>
            </div>
          </div>
        </div>

      </section>

      <section
        class="info-section"
        id="section-4"
        data-section="section4"
        aria-labelledby="education-title"
      >
        <div class="section-heading">
          <p class="section-kicker" data-i18n="educationKicker">05 / wykształcenie</p>
          <h2 id="education-title" data-i18n="educationTitle">Wykształcenie.</h2>
        </div>

        <div class="timeline">
          <div class="timeline-item">
            <p class="info-label" data-i18n="educationItemOneMeta">2025 — teraz</p>
            <div>
              <p class="info-value" data-i18n="educationItemOne">Cyberbezpieczeństwo @ Uniwersytet VIZJA</p>
              <p class="info-note" data-i18n="educationItemOnePlace">lic.</p>
            </div>
          </div>
          <div class="timeline-item">
            <p class="info-label" data-i18n="educationItemTwoMeta">2021 — teraz</p>
            <div>
              <p class="info-value" data-i18n="educationItemTwo">Filologia angielska @ Uniwersytet Warszawski</p>
              <p class="info-note" data-i18n="educationItemTwoPlace">lic.</p>
            </div>
          </div>
        </div>
        <div class="education-languages" id="section-5" aria-labelledby="languages-title">
          <h3 class="stack-label" id="languages-title" data-i18n="languagesTitle">Języki.</h3>
        <div class="language-grid">
          <div class="language-card">
            <span class="language-code">PL</span>
            <span class="language-level" data-i18n="polishLevel">Native</span>
          </div>
          <div class="language-card">
            <span class="language-code">EN</span>
            <div class="language-detail">
              <span class="language-level" data-i18n="englishLevel">C1</span>
              <span class="language-note" data-i18n="englishEvidence">(UW, 2024 & FCE, 2017)</span>
            </div>
          </div>
          <div class="language-card">
            <span class="language-code">DE</span>
            <span class="language-level" data-i18n="germanLevel">B1+</span>
          </div>
        </div>
        </div>
      </section>



      <section
        class="contact-section info-section"
        id="section-7"
        data-section="section7"
        aria-labelledby="contact-title"
      >
        <div class="section-heading">
          <p class="section-kicker" data-i18n="contactKicker">06 / kontakt</p>
          <h2 id="contact-title" data-i18n="contactTitle">Porozmawiajmy.</h2>
        </div>
        <div class="contact-content">
          <p class="contact-copy" data-i18n="contactCopy">
            Masz pomysł albo projekt, który potrzebuje spokojnej formy? Napisz.
          </p>
          <div class="contact-right">
            <a class="contact-email" href="mailto:patryk1tk@gmail.com">
              patryk1tk@gmail.com<span class="contact-email-arrow" aria-hidden="true">↗</span>
            </a>

            <nav class="contact-links" data-i18n-attr="aria-label:contactSocialsLabel">
              <a class="contact-row" href="https://www.behance.net/2s0lace" target="_blank" rel="noreferrer">
                <span class="contact-row-label">behance</span>
                <span class="contact-row-value">2s0lace <span class="contact-row-arrow" aria-hidden="true">↗</span></span>
              </a>
              <a class="contact-row" href="https://www.linkedin.com/in/patryk-taborek-7691033ba/" target="_blank" rel="noreferrer">
                <span class="contact-row-label">linkedin</span>
                <span class="contact-row-value">Patryk Taborek <span class="contact-row-arrow" aria-hidden="true">↗</span></span>
              </a>
              <a class="contact-row" href="https://www.instagram.com/2s0lace/" target="_blank" rel="noreferrer">
                <span class="contact-row-label">instagram</span>
                <span class="contact-row-value">@2s0lace <span class="contact-row-arrow" aria-hidden="true">↗</span></span>
              </a>
            </nav>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span data-i18n="common.footerCopyright">© 2026 Patryk</span>
      <a class="footer-contact" href="#section-7" data-section-link="section7" data-i18n="common.contact">Kontakt</a>
      <a href="mailto:patryk1tk@gmail.com">patryk1tk@gmail.com <span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</BaseLayout>

<script src="../scripts/mode-switch.js"></script>
